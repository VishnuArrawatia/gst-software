# GST ERP — environment
# Copy this file to `.env` and fill in your PostgreSQL password.
# `.env` is git-ignored; this template is not.

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=gst_erp

# Where the monthly source files live (SAP purchase register, GSTR-2B download,
# SAP sales register). File type is detected from the headers, so the file name
# does not matter.
GST_INPUT_DIR=D:\c drive\Desktop\GST Monthly Input

# Where the generated workbook and return JSON land.
GST_OUTPUT_DIR=F:\GST-SOFTWARE\output

# Optional: the GSTIN to attribute sales rows to when the sales export has no
# "Our GSTIN" column (common when the export is already scoped to one unit).
# Example: 26AALCS9985J1ZC
# GST_SALES_GSTIN=
